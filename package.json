{
  "name": "relaxxo",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "convex": "convex dev",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web && node scripts/postbuild-web.mjs",
